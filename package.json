  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyanix-0721/dsh-search-fetch-router.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "tavily",
    "firecrawl",
    "web-search",
    "web-fetch"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
