    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
